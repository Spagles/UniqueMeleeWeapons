  <UMW_GoldInlay.traitAdjectives.1>黄金の</UMW_GoldInlay.traitAdjectives.1>


  <!-- EN: head-weighted -->
  <UMW_HeadWeighted.label>先重心</UMW_HeadWeighted.label>

  <!-- EN: Mass is gathered toward the striking end so each swing lands with devastating force, though it is slower to recover. -->
  <UMW_HeadWeighted.description>質量が打撃側の端に寄せられているため,一振りごとに壊滅的な力が乗りますが,立て直しは遅くなります.</UMW_HeadWeighted.description>

  <!-- EN: devastating -->
  <UMW_HeadWeighted.traitAdjectives.0>壊滅的な</UMW_HeadWeighted.traitAdjectives.0>

  <!-- EN: mighty -->
