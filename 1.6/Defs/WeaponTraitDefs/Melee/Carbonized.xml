<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- UMW_Melee. Renamed from "Scorched" (user, 2026-07-24 — "sounds cooler"); the description keeps
       the charred imagery the old name implied, and stays material-agnostic (chars wood, soots metal)
       since any stuff can roll it. Enameled is its aesthetic mirror (same BodyColor+Appearance tags and
       ForcedColorTwoExtension wiring, devaluing where Enameled enhances) but not its mechanical one:
       this is the only trait trading durability and value for combat performance — the real
       case-hardening/fire-hardening trade, hard surface over a brittle body.
       Why the brittleness is TWO stats: a weapon's HP is only spent by outdoor deterioration, fire and
       explosions — never by swinging it, and an equipped weapon doesn't deteriorate at all — so the HP
       cut alone would be free. The faster decay is what spends it, and MarketValue's StatPart_Health
       compounds the loss into the devaluation. Also note UniqueMeleeWeapon.PostPostMake must re-clamp
       HitPoints, since traits roll after PostMake has set HP from the unmodified max.
       Forces near-black UMW_CarbonBlack onto colour two (the green-masked body, replacing the stuff tint) —
       so "BodyColor", not the colour-one "Color": a charred weapon can still take a Gold/Jade inlay.
       "Appearance" keeps it from also rolling ornamental/ugly — it has its own look.
       canGenerateAlone false: like the inlays, an add-on flourish, not a standalone identity. -->
  <WeaponTraitDef>
    <defName>UMW_Carbonized</defName>
    <label>carbonized</label>
    <description>This weapon has been through fire. Its charred surface is hardened by the heat, and what is already burnt does not easily burn again. The hardened surface hits harder than it should, but the scorched body is brittle and weathers badly.</description>
    <commonality>0.5</commonality>
    <canGenerateAlone>false</canGenerateAlone>
    <weaponCategory>UMW_Melee</weaponCategory>
    <exclusionTags>
      <li>BodyColor</li>
      <li>Appearance</li>
    </exclusionTags>
    <statOffsets>
      <Beauty>-4</Beauty>
      <MarketValue>20</MarketValue> <!-- prices the hardening; well under Studded's +60 -->
    </statOffsets>
    <statFactors>
      <!-- Weapon-wide, NOT a per-tool damageFactor: this stat also drives armor pen (melee has no
           separate AP stat), and a harder surface biting deeper is the intent. -->
      <MeleeWeapon_DamageMultiplier>1.05</MeleeWeapon_DamageMultiplier>
      <MaxHitPoints>0.8</MaxHitPoints>
      <DeteriorationRate>1.5</DeteriorationRate>
      <!-- Already-burnt resists further burning — real: Thing.FlammableNow and
           DamageDef.igniteChanceByTargetFlammability both read this per-thing. -->
      <Flammability>0.5</Flammability>
      <MarketValue>0.8</MarketValue> <!-- cf. Ugly's devaluation; pairs with the offset above -->
    </statFactors>
    <traitAdjectives>
      <li>carbonized</li>
      <li>fire-blackened</li>
      <li>charred</li>
      <li>soot-stained</li>
    </traitAdjectives>
    <modExtensions>
      <li Class="UniqueMeleeWeapons.ForcedColorTwoExtension">
        <color>UMW_CarbonBlack</color>
      </li>
    </modExtensions>
  </WeaponTraitDef>

</Defs>
