  <!-- EN: charge -->
  <UMW_Piledriver.abilityProps.chargeNoun>충전</UMW_Piledriver.abilityProps.chargeNoun>

  <!-- EN: on cooldown -->
  <UMW_Piledriver.abilityProps.cooldownGerund>재사용 대기 중</UMW_Piledriver.abilityProps.cooldownGerund>


  <!-- EN: plasma-cored -->
  <UMW_PlasmaCored.label>플라즈마 코어</UMW_PlasmaCored.label>

  <!-- EN: The core of the blade channels a sheath of plasma, held in place by an energy field and released into the wounds it cuts. It sears flesh and sometimes ignites the target. -->
  <UMW_PlasmaCored.description>칼날의 코어가 플라즈마 막을 흘려보내고, 에너지장이 그것을 붙잡아 두었다가 베어낸 상처 속으로 풀어 놓습니다. 플라즈마는 살을 태우고, 때로는 목표물에 불을 붙입니다.</UMW_PlasmaCored.description>

