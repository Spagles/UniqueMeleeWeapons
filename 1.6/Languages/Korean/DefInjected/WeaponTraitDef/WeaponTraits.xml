  <UMW_Quilloned.traitAdjectives.0>날받이 달린</UMW_Quilloned.traitAdjectives.0>

  <!-- EN: cross-guarded -->
  <UMW_Quilloned.traitAdjectives.1>십자 가드의</UMW_Quilloned.traitAdjectives.1>

  <!-- EN: warding -->
