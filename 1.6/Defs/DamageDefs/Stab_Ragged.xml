<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Base-damage target for the UMW_Barbed trait. The DamageConversion postfix reroutes the weapon's
       normal Stab hit to this in place (no extra damage stacked) — see the on-hit-effects note in
       CLAUDE.md. Faithful clone of Core's Stab (keeps DamageWorker_Stab, Sharp armor,
       stabChanceOfForcedInternal, the overkill curve), differing only in routing the wound to the
       bleedier, scar-prone UMW_Stab_Ragged injury hediff of the same name (mirrors vanilla's Stab
       DamageDef -> Stab hediff pairing). Cloned, NOT ParentName="Stab": vanilla Stab carries no Name=
       attribute so it can't be a parent (same gotcha as UMW_Stab_Tox / UMW_Cut_Ragged). Label stays
       "stab" to keep the combat log clean; the "ragged" flavor rides the injury hediff's label. -->
  <DamageDef>
    <defName>UMW_Stab_Ragged</defName>
    <label>stab</label>
    <workerClass>DamageWorker_Stab</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} has been stabbed to death.</deathMessage>
    <hediff>UMW_Stab_Ragged</hediff>
    <hediffSolid>Crack</hediffSolid>
    <impactSoundType>Slice</impactSoundType>
    <armorCategory>Sharp</armorCategory>
    <stabChanceOfForcedInternal>0.6</stabChanceOfForcedInternal>
    <overkillPctToDestroyPart>0.4~1.0</overkillPctToDestroyPart>
  </DamageDef>

</Defs>
