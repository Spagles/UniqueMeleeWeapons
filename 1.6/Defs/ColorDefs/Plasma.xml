<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Bright plasma orange, sampled from Royalty's plasmasword texture's main blade colour. Forced
       BODY colour (colour two / green mask) for UMW_PlasmaCored via ForcedColorTwoExtension. Odyssey's
       UniqueWeapon_Fire (167, 96, 39) was tried first and reads as wood-brown when it tints the whole
       body — it's calibrated as a small colour-one accent, not a full-blade tint. Self-contained like
       UMW_Blood/UMW_MonoWhite: Weapon colorType, randomlyPickable=false so it never enters the random
       weapon-colour pool. MayRequire-gated together with its sole consumer UMW_PlasmaCored (a
       Royalty-tech reference). -->
  <ColorDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>UMW_Plasma</defName>
    <label>plasma orange</label>
    <colorType>Weapon</colorType>
    <color>(252, 146, 49)</color>
    <randomlyPickable>false</randomlyPickable>
  </ColorDef>

</Defs>
