<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- UMW_Bladed. Edge — a mechanite-sustained mono-molecular edge that shears through armor: a
       reference to Royalty's monosword tech, so the def is MayRequire-gated on Royalty (the same
       def-level gate the Axe/Warhammer uniques use) together with its UMW_MonoWhite ColorDef — the
       trait only rolls when the DLC that owns the tech is present. Realises "ignores armor" via
       MeleeToolModExtension, which floors the Cut AND Stab tools' armor penetration to 0.97 (the only
       trait that raises a base hit's AP without also raising its damage — AP is wasted on unarmored
       targets but devastating vs plate/mechs). Flashy, so rarer (commonality 0.5). Forces the
       pure-white UMW_MonoWhite onto COLOUR TWO (the body) via ForcedColorTwoExtension, so it tags
       BodyColor (its own one-per-weapon family) — being on a different mask channel than the
       Color-tagged inlays, it can co-occur with a Gold/Jade inlay. The Edge tag keeps it mutually
       exclusive with Razored/Serrated. Additionally suppressed by the allowUltratechTraits setting,
       which medieval-only runs turn off (Patches/CompUniqueWeapon_UltratechTraits_Patch.cs). -->
  <WeaponTraitDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>UMW_Monomolecular</defName>
    <label>monomolecular</label>
    <description>The edge is honed to a single molecule and held there by a lattice of mechanites. It parts armor and bone as though they were not there.</description>
    <commonality>0.5</commonality>
    <weaponCategory>UMW_Bladed</weaponCategory>
    <exclusionTags>
      <li>Edge</li>
      <li>BodyColor</li>
    </exclusionTags>
    <statOffsets>
      <MarketValue>120</MarketValue> <!-- premium tier, cf. ChargeCapacitor -->
    </statOffsets>
    <traitAdjectives>
      <li>mono-edged</li>
      <li>crystalline</li>
      <li>honed</li>
    </traitAdjectives>
    <modExtensions>
      <li Class="UniqueMeleeWeapons.MeleeToolModExtension">
        <mods>
          <li>
            <capacities>
              <li>Cut</li>
              <li>Stab</li>
            </capacities>
            <armorPenetrationFloor>0.97</armorPenetrationFloor> <!-- Slightly worse than royalty's monosword's 0.99 -->
          </li>
        </mods>
      </li>
      <li Class="UniqueMeleeWeapons.ForcedColorTwoExtension">
        <color>UMW_MonoWhite</color>
      </li>
    </modExtensions>
  </WeaponTraitDef>

</Defs>
