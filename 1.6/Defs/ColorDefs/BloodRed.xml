<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Dried-blood red. Forced BODY colour (colour two / green mask) for UMW_BloodStained, applied
       via ForcedColorTwoExtension — it replaces the stuff/material tint rather than the colour-one accent.
       (A weapon ColorDef works on either channel; only the trait wiring decides which.) Because it rides
       the same multiply channel as stuff tints, it's calibrated to vanilla stuffProps colour statistics
       so the gore reads as a material, not near-black paint: saturation ~0.63, between wood (133,97,67,
       ~0.50) and devilstrand (180,60,60, ~0.67) but darker than the latter. The original (120,20,20,
       sat ~0.83) rendered close to dark wood on the sprite. Hue sits just *below* pure red (~352°,
       the crimson side) rather than just above it: with blue as the low channel the multiply skewed
       brick/orange over the warm diffuse. Saturation and value are unchanged from that earlier
       (140,58,52) tuning — only the green/blue split moved. Self-contained
       rather than ParentName="UniqueWeaponColorBase" (Odyssey's abstract base): it only sets the two
       fields that base provides — a Weapon colorType and randomlyPickable=false so it never shows up in
       the random weapon-colour pool — so depending on a DLC's abstract node buys nothing. -->
  <ColorDef>
    <defName>UMW_BloodRed</defName>
    <label>blood red</label>
    <colorType>Weapon</colorType>
    <color>(140, 52, 64)</color>
    <randomlyPickable>false</randomlyPickable>
  </ColorDef>

</Defs>
