<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Royal purple. Forced BODY colour (colour two / green mask) for UMW_Enameled, applied via
       ForcedColorTwoExtension — same wiring as UMW_Blood/UMW_Carbon, replacing the stuff/material
       tint with a vitreous colour-coat rather than an accent. Violet is the one open hue slot left in
       the mod's colour-two palette after this spec (see CLAUDE.md/spec §4): bodies run blood-crimson/
       carbon near-black/mono-white/plasma-orange, and accents run gold/jade/tox/fire/EMP — none of
       them violet, so this reads as its own, unambiguous material.
       Starting value #7851A9 (120, 81, 169), sat ≈0.52 at a mid-high value — calibrated to sit in the
       same "readable, moderately saturated tint" band as blood (~0.63) and devilstrand (~0.67) rather
       than a washed-out pastel. User eyeball pending (spec §8/D10), including how it reads beside a
       Gold or Jade colour-one accent inlay (different mask channel, so they can legally co-occur).
       Session alternates if the pick needs adjustment: darker (104, 68, 150), redder-violet
       (128, 74, 164). Self-contained rather than ParentName="UniqueWeaponColorBase" — see UMW_Blood's
       comment for why. -->
  <ColorDef>
    <defName>UMW_Enamel</defName>
    <label>royal purple</label>
    <colorType>Weapon</colorType>
    <color>(120, 81, 169)</color>
    <randomlyPickable>false</randomlyPickable>
  </ColorDef>

</Defs>
