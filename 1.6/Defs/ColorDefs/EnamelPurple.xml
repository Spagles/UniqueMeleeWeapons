<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Enamel purple. Forced BODY colour (colour two / green mask) for UMW_Enameled, applied via
       ForcedColorTwoExtension — same wiring as UMW_BloodRed/UMW_CarbonBlack, replacing the stuff/material
       tint with a vitreous colour-coat rather than an accent. Violet is the one open hue slot left in
       the mod's colour-two palette: bodies run blood-crimson/
       carbon near-black/mono-white/plasma-orange, and accents run gold/jade/tox/fire/EMP — none of
       them violet, so this reads as its own, unambiguous material.
       #7851A9 (120, 81, 169), sat ≈0.52 at a mid-high value — calibrated to sit in the
       same "readable, moderately saturated tint" band as blood (~0.63) and devilstrand (~0.67) rather
       than a washed-out pastel. Confirmed in-game, including beside a Gold or Jade colour-one accent
       inlay (different mask channel, so they can legally co-occur). Self-contained rather than ParentName="UniqueWeaponColorBase" — see UMW_BloodRed's
       comment for why. -->
  <ColorDef>
    <defName>UMW_EnamelPurple</defName>
    <label>enamel purple</label>
    <colorType>Weapon</colorType>
    <color>(120, 81, 169)</color>
    <randomlyPickable>false</randomlyPickable>
  </ColorDef>

</Defs>
