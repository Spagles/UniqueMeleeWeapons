<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The warband's camp - the low-tech counterpart to Odyssey's ancients-themed BanditGang site part.
    Like BanditGang this is purely descriptive (no workerClass): the defenders are spawned by the
    quest (QuestNode_Root_Warband + QuestPart_SpawnWarband), and the structure they spawn into comes
    from the tile mutator the root node adds, not from this def.
  -->
  <SitePartDef>
    <defName>UMW_WarbandCamp</defName>
    <label>warband camp</label>
    <description>A hostile warband hiding out in an abandoned settlement.</description>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <siteTexture>World/WorldObjects/Sites/Outpost</siteTexture>
    <!-- <expandingIconTexture>World/WorldObjects/Expanding/AncientMercenaries</expandingIconTexture> -->
    <expandingIconTexture>World/WorldObjects/Expanding/UMW_WarbandCamp</expandingIconTexture>

    <tags>
      <li>UMW_WarbandCamp</li>
    </tags>
  </SitePartDef>

</Defs>
