  <!-- EN: fiery -->
  <UMW_PlasmaCored.traitAdjectives.3>불타는</UMW_PlasmaCored.traitAdjectives.3>

  <!-- EN: incandescent -->
  <UMW_PlasmaCored.traitAdjectives.4>백열의</UMW_PlasmaCored.traitAdjectives.4>


