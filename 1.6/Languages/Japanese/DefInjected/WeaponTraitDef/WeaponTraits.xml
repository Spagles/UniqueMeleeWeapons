  <!-- EN: ponderous -->
  <UMW_HeadWeighted.traitAdjectives.2>重々しい</UMW_HeadWeighted.traitAdjectives.2>


  <!-- EN: jade inlay -->
  <UMW_JadeInlay.label>ヒスイの象眼</UMW_JadeInlay.label>

  <!-- EN: This weapon is adorned with jade. Traders will pay more for it. -->
  <UMW_JadeInlay.description>この武器はヒスイで装飾されています.貿易商は高値でこれを買い取ります.</UMW_JadeInlay.description>

  <!-- EN: jade -->
  <UMW_JadeInlay.traitAdjectives.0>ヒスイの</UMW_JadeInlay.traitAdjectives.0>


  <!-- EN: lightweight -->
  <UMW_Lightweight.label>軽量</UMW_Lightweight.label>

  <!-- EN: This weapon is much lighter than normal, quickening its swing. -->
  <UMW_Lightweight.description>この武器は通常よりも大幅に軽いため,振りが速くなります.</UMW_Lightweight.description>

  <!-- EN: light -->
  <UMW_Lightweight.traitAdjectives.0>軽い</UMW_Lightweight.traitAdjectives.0>

