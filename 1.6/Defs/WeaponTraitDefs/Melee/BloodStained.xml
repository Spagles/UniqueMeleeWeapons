<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- UMW_Melee. Blood-stained — gore-caked, and balanced rather than purely beneficial: the menace that
       panics enemies also unsettles the wielder.
         • On-hit "dread": a wounding blow can panic a target into fleeing (PanicFlee via
           MeleeOnHitEffect_MentalState); humanlikeOnly, since animals/mechs don't scare. Chance 0.12
           sits between two anchors: a proc is a ROUT, not a stagger (PanicFlee's minTicksBeforeRecovery
           is 10,000t), so it must stay well under Bell-cast's 0.25 for a mere 2s stun; but vanilla
           already auto-panics humanlikes below their kindDef fleeHealthThresholdRange, so only
           early-fight routs read as the trait working, and much below 0.12 it reads as inert.
         • Mood: one two-stage ThoughtDef (UMW_BloodStainedWeapon) — -2 for ordinary pawns, +3 for
           bloodlusters, nullified for the hardened. See that file for why it must be a single def.
       Forces UMW_BloodRed onto COLOUR TWO via ForcedColorTwoExtension, not vanilla's colour-one
       forcedColor: the gore reads as the body itself, so it replaces the material tint and tags
       "BodyColor" rather than "Color" — leaving it free to co-roll with a colour-one Gold/Jade inlay.
       Also tags "Appearance": a gore-caked weapon has its own look, so it never also rolls
       ornamental/ugly. Carries both MarketValue halves per the CLAUDE.md rule — ×0.8 for the gore,
       +40 for the panic, half Bell-cast's +80 (weaker proc, humanlike-only). Commonality 0.5 keeps the
       "Appearance" family uniform, as Odyssey's is; at 1.0 it took over half the family's rolls and
       buried the four cosmetics it excludes. canGenerateAlone defaults true: a complete identity. -->
  <WeaponTraitDef>
    <defName>UMW_BloodStained</defName>
    <label>blood-stained</label>
    <description>This weapon is caked in layers of dark, dried blood. The sight of it can send the people it wounds fleeing in panic, though carrying so grisly a thing weighs on all but the hardened. Traders will pay less for it.</description>
    <commonality>0.5</commonality>
    <weaponCategory>UMW_Melee</weaponCategory>
    <exclusionTags>
      <li>BodyColor</li>
      <li>Appearance</li>
    </exclusionTags>
    <statOffsets>
      <MarketValue>40</MarketValue> <!-- the panic capability: half Bell-cast's +80 (weaker proc, humanlike-only) -->
    </statOffsets>
    <statFactors>
      <MarketValue>0.8</MarketValue> <!-- the gore devaluation, cf. Ugly -->
    </statFactors>
    <traitAdjectives>
      <li>blood-stained</li>
      <li>bloody</li>
      <li>gory</li>
      <li>sanguine</li>
    </traitAdjectives>
    <modExtensions>
      <li Class="UniqueMeleeWeapons.MeleeTraitEffectExtension">
        <onHitEffects>
          <li Class="UniqueMeleeWeapons.MeleeOnHitEffect_MentalState">
            <stateDef>PanicFlee</stateDef>
            <humanlikeOnly>true</humanlikeOnly>
            <chance>0.12</chance>
          </li>
        </onHitEffects>
      </li>
      <li Class="UniqueMeleeWeapons.ForcedColorTwoExtension">
        <color>UMW_BloodRed</color>
      </li>
    </modExtensions>
  </WeaponTraitDef>

</Defs>
