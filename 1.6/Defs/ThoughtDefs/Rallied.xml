<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Memory thought granted by UMW_RallyingCry (AbilityDefs/RallyingCry.xml) to every player-faction
       humanlike in earshot/eyeshot of the caster (see CompAbilityEffect_RallyAllies). A plain,
       vanilla-shaped memory thought — durationDays 1 / stackLimit 1 means a second cry before the
       first wears off just refreshes it rather than stacking mood on mood. -->
  <ThoughtDef>
    <defName>UMW_Rallied</defName>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>rallied</label>
        <description>The rallying cry still rings in my ears — seeing that storied blade held high stirred something in me.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
