<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Repoint Odyssey's two class-based unique-weapon rolls off the stock ThingSetMaker_UniqueWeapon
       onto our ThingSetMaker_UMWUnique (a ThingSetMaker_MarketValue subclass). Two reasons:

         1. Hardening. ThingSetMaker_UniqueWeapon calls MakeThing(def) with no stuff. Our melee uniques
            are stuffable, so it logs a red "madeFromStuff but stuff=null" error and forces them to steel.
            MarketValue builds via ThingStuffPairWithQuality (passes a stuff; preserves the comp's Super
            quality), so the error is gone.
         2. Pool separation. Our subclass keeps the comp-based candidate set MINUS our weapons, so the
            quest / orbital stash roll Odyssey's (and other mods') uniques but never ours — ours are
            reserved for our own pool (UMW_Reward_UniqueWeapon). Other mods' uniques are unaffected.

       Behaviour is preserved: ThingSetMaker_Sum hands the (sole) quest option the full points->value
       window, and MarketValue honours totalMarketValueRange + countRange. qualityGenerator=Super is added
       so the value ESTIMATE used during selection matches the actual Super weapon (matching how the stock
       class selected on real Super value).

       Each consumer is wrapped in a PatchOperationConditional keyed on the exact node we expect
       (thingSetMaker[@Class="ThingSetMaker_UniqueWeapon"]). If a future Odyssey restructure removes or
       renames it, the patch simply no-ops instead of erroring. The Class predicate also scopes the ops to
       the unique-weapon option only (MapGen_OrbitalItemStash also has a stockpile sub-tree option). Within
       each sequence the Add runs before the AttributeSet so both still match on the old Class. -->

  <!-- Reward_UniqueWeapon — used by the AncientMercenaries quest (QuestNode_Root_AncientMercenaries). -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingSetMakerDef[defName="Reward_UniqueWeapon"]/root/options/li/thingSetMaker[@Class="ThingSetMaker_UniqueWeapon"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingSetMakerDef[defName="Reward_UniqueWeapon"]/root/options/li/thingSetMaker[@Class="ThingSetMaker_UniqueWeapon"]</xpath>
          <value>
            <fixedParams>
              <qualityGenerator>Super</qualityGenerator>
            </fixedParams>
          </value>
        </li>
        <li Class="PatchOperationAttributeSet">
          <xpath>Defs/ThingSetMakerDef[defName="Reward_UniqueWeapon"]/root/options/li/thingSetMaker[@Class="ThingSetMaker_UniqueWeapon"]</xpath>
          <attribute>Class</attribute>
          <value>UniqueMeleeWeapons.ThingSetMaker_UMWUnique</value>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- MapGen_OrbitalItemStash — the unique-weapon option of an orbital platform's item-stash room. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingSetMakerDef[defName="MapGen_OrbitalItemStash"]/root/options/li/thingSetMaker[@Class="ThingSetMaker_UniqueWeapon"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingSetMakerDef[defName="MapGen_OrbitalItemStash"]/root/options/li/thingSetMaker[@Class="ThingSetMaker_UniqueWeapon"]</xpath>
          <value>
            <fixedParams>
              <qualityGenerator>Super</qualityGenerator>
            </fixedParams>
          </value>
        </li>
        <li Class="PatchOperationAttributeSet">
          <xpath>Defs/ThingSetMakerDef[defName="MapGen_OrbitalItemStash"]/root/options/li/thingSetMaker[@Class="ThingSetMaker_UniqueWeapon"]</xpath>
          <attribute>Class</attribute>
          <value>UniqueMeleeWeapons.ThingSetMaker_UMWUnique</value>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>
