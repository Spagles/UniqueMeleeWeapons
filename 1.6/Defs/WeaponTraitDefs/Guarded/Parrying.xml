<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- UMW_Guarded. Identity/construction-feature trait — quillons, a basket, or a main-gauche-style
       crossguard let the wielder catch and turn aside an incoming blow. Gated on the weapon's
       physical shape via the UMW_Guarded category (longsword/gladius only — see that category's
       file comment), not on an exclusionTags family the way mechanism traits are; "Guard" is instead
       the family token this trait ITSELF seeds for future guard-shape members (riposte, a
       sword-breaker's bind) so at most one guard-family effect ever stacks.
       Wielder buff rides the equipped UMW_ParryingGuard hediff, NOT equippedStatOffsets — that field
       is bladelink-only and silently inert on our CompUniqueWeapon (see the hediff's own header
       comment; same pattern as UMW_NeedlePoint's malus).
       MV +50 offset (added capability, not a scaling/devaluation factor): priced at parity with
       Odyssey's ranged QuickReload — the nearest survivability/combat-tempo utility buff at this
       tier (below AimAssistance's +70 accuracy swing, above CustomGrip's +15 cosmetic-adjacent
       nudge). canGenerateAlone defaults true: parrying is a complete, nameable identity on its own,
       though UMW_Lightweight backstops generation regardless (every weapon's UMW_Melee membership
       guarantees an alone-able, adjective-bearing trait even if Parrying doesn't roll first). -->
  <WeaponTraitDef>
    <defName>UMW_Parrying</defName>
    <label>parrying</label>
    <description>Quillons — or a main-gauche-style guard — flare from the hilt, wide enough to catch an incoming blade and turn it aside.</description>
    <commonality>1</commonality>
    <weaponCategory>UMW_Guarded</weaponCategory>
    <exclusionTags>
      <li>Guard</li>
    </exclusionTags>
    <statOffsets>
      <MarketValue>50</MarketValue> <!-- cf. QuickReload -->
    </statOffsets>
    <equippedHediffs>
      <li>UMW_ParryingGuard</li>
    </equippedHediffs>
    <traitAdjectives>
      <li>parrying</li>
      <li>warding</li>
      <li>guarded</li>
    </traitAdjectives>
  </WeaponTraitDef>

</Defs>
