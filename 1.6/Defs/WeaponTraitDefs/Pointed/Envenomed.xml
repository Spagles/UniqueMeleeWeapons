<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- UMW_Pointed. Coating — a thrust drives venom deep, stacking ToxicBuildup over a sustained fight
       (extra UMW_Stab_Tox hit @ 50%). Tags "Coating" (one coating per weapon — currently the only coating,
       but the tag keeps any future coating mutually exclusive) AND "Color", because it forces the green
       UniqueWeapon_Tox tint and so can't share a
       weapon with the Gold/Jade inlays. This mirrors Odyssey's ToxRounds, which tags AmmoType+Color
       (Coating is our melee analog of AmmoType). Combines freely with a point-shape trait
       (ArmorSpike/NeedlePoint, tag "Point").
       The payload IGNORES ARMOR rather than carrying its own AP: the on-hit postfix already gates on
       the base blow wounding, so the armor contest is decided by the weapon's real hit — the venom then
       rides the wound, exactly as the description promises ("in those it wounds"). An earlier
       armorPenetration 0.3 double-counted armor (payload re-rolled it) and surfaced in the info card as
       the coating itself piercing armor, which read as nonsense (2026-07 balance pass). Same rationale
       on UMW_Opiated. Odyssey's ToxRounds needs no equivalent because damageDefOverride converts the
       whole bullet, inheriting its single armor roll. -->
  <WeaponTraitDef>
    <defName>UMW_Envenomed</defName>
    <label>envenomed</label>
    <description>The point is coated in a slow neurotoxic venom which causes toxic buildup in those it wounds.</description>
    <commonality>1</commonality>
    <weaponCategory>UMW_Pointed</weaponCategory>
    <exclusionTags>
      <li>Coating</li>
      <li>Color</li>
    </exclusionTags>
    <forcedColor>UniqueWeapon_Tox</forcedColor>
    <statOffsets>
      <MarketValue>50</MarketValue>
    </statOffsets>
    <traitAdjectives>
      <li>envenomed</li>
      <li>venomous</li>
      <li>poisoned</li>
      <li>toxic</li>
    </traitAdjectives>
    <modExtensions>
      <li Class="UniqueMeleeWeapons.MeleeTraitEffectExtension">
        <onHitEffects>
          <li Class="UniqueMeleeWeapons.MeleeOnHitEffect_ExtraDamage">
            <def>UMW_Stab_Tox</def>
            <amount>3</amount>
            <ignoreArmor>true</ignoreArmor> <!-- rides the wound; see header -->
            <chance>0.5</chance>
          </li>
        </onHitEffects>
      </li>
    </modExtensions>
  </WeaponTraitDef>

</Defs>
