<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- Injury hediffs take the HediffDef words, which differ from the matching DamageDefs in French
       Core: HediffDef Stab = "perforation" where DamageDef Stab = "blessure par lame". Both wound
       nouns here are feminine, so every tended/permanent label agrees in -ée.

       labelNoun carries the indefinite article, as Core's own do ("une taillade", "une brûlure").
       The tended labels and the destroyed labels are Core's verbatim (bandée / suturée / plâtrée;
       Cut = Déchiqueté(e), Stab = Perforé(e), both cut-out = Sectionné(e)) — including the
       capitalized "(e)" hedge Core uses for those participles. -->

  <!-- EN: ragged cut -->
  <UMW_Cut_Ragged.label>taillade déchiquetée</UMW_Cut_Ragged.label>

  <!-- EN: a ragged cut -->
  <UMW_Cut_Ragged.labelNoun>une taillade déchiquetée</UMW_Cut_Ragged.labelNoun>

  <!-- EN: {0} in the {1} -->
  <UMW_Cut_Ragged.labelNounPretty>une {0} au/à la {1}</UMW_Cut_Ragged.labelNounPretty>

  <!-- EN: A ragged, torn cut that bleeds freely and scars badly. -->
  <UMW_Cut_Ragged.description>Une taillade déchiquetée et déchirée qui saigne abondamment et laisse une vilaine cicatrice.</UMW_Cut_Ragged.description>

  <!-- EN: bandaged -->
  <UMW_Cut_Ragged.comps.0.labelTendedWell>bandée</UMW_Cut_Ragged.comps.0.labelTendedWell>

  <!-- EN: sutured -->
  <UMW_Cut_Ragged.comps.0.labelTendedWellInner>suturée</UMW_Cut_Ragged.comps.0.labelTendedWellInner>

  <!-- EN: set -->
  <UMW_Cut_Ragged.comps.0.labelSolidTendedWell>plâtrée</UMW_Cut_Ragged.comps.0.labelSolidTendedWell>

  <!-- EN: ragged scar -->
  <UMW_Cut_Ragged.comps.2.permanentLabel>cicatrice déchiquetée</UMW_Cut_Ragged.comps.2.permanentLabel>

  <!-- EN: Cut off -->
  <UMW_Cut_Ragged.injuryProps.destroyedLabel>Déchiqueté(e)</UMW_Cut_Ragged.injuryProps.destroyedLabel>

  <!-- EN: Cut out -->
  <UMW_Cut_Ragged.injuryProps.destroyedOutLabel>Sectionné(e)</UMW_Cut_Ragged.injuryProps.destroyedOutLabel>


  <!-- EN: rallied -->
  <UMW_Rallied.label>galvanisé</UMW_Rallied.label>

  <!-- EN: Stirred by the rallying cry of a storied weapon's bearer. For a time, wounds barely register, and a hit does little to break their stride. -->
  <UMW_Rallied.description>Galvanisé par le cri de ralliement du porteur d'une arme de renom. Pendant un temps, les blessures se font à peine sentir, et un coup ne suffit guère à briser son élan.</UMW_Rallied.description>


  <!-- EN: sedative buildup -->
  <UMW_SedativeBuildup.label>accumulation de sédatif</UMW_SedativeBuildup.label>

  <!-- EN: A fast-acting sedative building up in the bloodstream. At high levels it renders creatures unconscious. -->
  <UMW_SedativeBuildup.description>Un sédatif à action rapide qui s'accumule dans le sang. À forte dose, il rend les créatures inconscientes.</UMW_SedativeBuildup.description>

  <!-- The upper two stages reuse Core Anesthetic's own ladder (vaseux / sous sédatif), so only the
       first stage needed a word of its own. -->
  <!-- EN: dosed -->
  <UMW_SedativeBuildup.stages.0.label>dosé</UMW_SedativeBuildup.stages.0.label>

  <!-- EN: woozy -->
  <UMW_SedativeBuildup.stages.1.label>vaseux</UMW_SedativeBuildup.stages.1.label>

  <!-- EN: sedated -->
  <UMW_SedativeBuildup.stages.2.label>sous sédatif</UMW_SedativeBuildup.stages.2.label>


