<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- UMW_Blunt. The kinetic blunt stun: the head is cast solid the way a bell is cast, so a clean blow
       rings resonant shock through armor and bone, briefly stunning the struck (120t @ 25%), flesh and
       mechs alike.
       The "Head" token makes it mutually exclusive with UMW_ZeusHeaded (the electromagnetic, mech-only blunt
       stun) and UMW_DeadBlow (the shot-filled stagger head) — a weapon gets one blunt-head incapacitation
       effect.
       Priced at parity with Odyssey's ranged ParalyticArrows (+80): same 120t (2s, human) stun. The 25%
       proc gate is the melee-safe divergence — a guaranteed 2s stun at a ~2s swing cooldown would stunlock;
       ParalyticArrows can afford 100% because a bow can't fight in melee. Lower per-hit uptime than the arrow
       (which also re-stuns up to its 240t adaptation) is offset by Bell-cast's universal target (stuns mechs
       too, which ParalyticArrows can't) and no adaptation gate (every proc refreshes). Sits just above its
       mech-only Head sibling UMW_ZeusHeaded (+75). -->
  <WeaponTraitDef>
    <defName>UMW_BellCast</defName>
    <label>bell-cast</label>
    <description>The head is cast solid like a bell. A clean strike rings a resonance through armor and bone, briefly stunning the target.</description>
    <commonality>1</commonality>
    <weaponCategory>UMW_Blunt</weaponCategory>
    <exclusionTags>
      <li>Head</li>
    </exclusionTags>
    <statOffsets>
      <MarketValue>80</MarketValue> <!-- parity with ParalyticArrows +80 (matched 120t stun) -->
    </statOffsets>
    <traitAdjectives>
      <li>bell-cast</li>
      <li>ringing</li>
      <li>resonant</li>
    </traitAdjectives>
    <modExtensions>
      <li Class="UniqueMeleeWeapons.MeleeTraitEffectExtension">
        <onHitEffects>
          <li Class="UniqueMeleeWeapons.MeleeOnHitEffect_Stun">
            <ticks>120</ticks>
            <chance>0.25</chance>
          </li>
        </onHitEffects>
      </li>
    </modExtensions>
  </WeaponTraitDef>

</Defs>
