<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- UMW_Blunt. Pure stat mod, untagged (no exclusionTags). A studded/knurled head bites harder on
       impact — MeleeToolModExtension raises the Blunt tool's damage 15%, no AP change (per-tool
       damageFactor doesn't ride the AP stat, unlike MeleeWeapon_DamageMultiplier). Co-roll ceiling
       checked against UMW_Heavy's UMW_HeadWeighted (×1.3 damage @ ×1.18 cooldown, AP-neutralized via its
       own AP factor): a warhammer rolling both stacks to a legal, if punishing, ~×1.5 combined damage
       multiplier — inside Odyssey's own precedent for compounding damage/cooldown factors, and
       AP stays untouched by either trait. Priced under Odyssey's BroadheadArrows (+30% dmg = +60):
       half the damage bonus, so +50 keeps it above the pure-AP +40 tier. -->
  <WeaponTraitDef>
    <defName>UMW_Studded</defName>
    <label>studded</label>
    <description>The head is set with hard studs that concentrate the impact, driving extra force into every blow.</description>
    <commonality>1</commonality>
    <weaponCategory>UMW_Blunt</weaponCategory>
    <statOffsets>
      <MarketValue>50</MarketValue> <!-- BroadheadArrows prices +30% at +60, so +15% sits below it; level with Razored's damage+AP -->
    </statOffsets>
    <traitAdjectives>
      <li>studded</li>
      <li>knurled</li>
      <li>cruel</li>
    </traitAdjectives>
    <modExtensions>
      <li Class="UniqueMeleeWeapons.MeleeToolModExtension">
        <mods>
          <li>
            <capacities>
              <li>Blunt</li>
            </capacities>
            <damageFactor>1.15</damageFactor>
          </li>
        </mods>
      </li>
    </modExtensions>
  </WeaponTraitDef>

</Defs>
