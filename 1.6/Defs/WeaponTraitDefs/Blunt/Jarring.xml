<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- UMW_Blunt. Head — a jarring blow that rattles the struck rather than dropping them: MOVEMENT-only
       debuff via the new MeleeOnHitEffect_Stagger (target keeps fighting, just slower), hence the higher
       0.5 proc chance vs UMW_Concussive/UMW_ZeusHeaded's stuns (0.25/no-gate-but-adaptation-limited) — a
       stagger is a much milder incapacitation than a stun, so it can afford to land twice as often.
       ticks 95 / moveSpeedFactor 0.17 are vanilla's own bullet-impact stagger numbers
       (Pawn_StanceTracker.StaggerBulletImpactTicks / StaggerHandler.DefaultStaggerMoveSpeedFactor,
       decompile-verified), reused here as the melee-equivalent kinetic jolt. Works on mechs
       (mirrors Concussive; fleshOnly left at its default false — a girder-limbed mech rattles too).
       Victim-side counterplay rides the StaggerDurationFactor stat; StaggerFor max-merges rather than
       stacking, so repeated procs can't chain into a permalock (decompile-verified per spec).
       Shares the "Head" token with Concussive/ZeusHeaded — one blunt-head incapacitation effect per
       weapon. Priced at parity with Odyssey's ranged OversizedRounds (+50). -->
  <WeaponTraitDef>
    <defName>UMW_Jarring</defName>
    <label>jarring</label>
    <description>The head lands with a jarring, off-balancing shock — the struck reels and stumbles, even if the blow doesn't drop them.</description>
    <commonality>1</commonality>
    <weaponCategory>UMW_Blunt</weaponCategory>
    <exclusionTags>
      <li>Head</li>
    </exclusionTags>
    <statOffsets>
      <MarketValue>50</MarketValue> <!-- cf. OversizedRounds -->
    </statOffsets>
    <traitAdjectives>
      <li>jarring</li>
      <li>battering</li>
      <li>staggering</li>
    </traitAdjectives>
    <modExtensions>
      <li Class="UniqueMeleeWeapons.MeleeTraitEffectExtension">
        <onHitEffects>
          <!-- MeleeOnHitEffect_Stagger: added alongside this trait in a parallel C# change
               (Source/1.6/Traits/MeleeOnHitEffect.cs) — victim.stances.stagger.StaggerFor(ticks,
               moveSpeedFactor). -->
          <li Class="UniqueMeleeWeapons.MeleeOnHitEffect_Stagger">
            <ticks>95</ticks>
            <moveSpeedFactor>0.17</moveSpeedFactor>
            <chance>0.5</chance>
          </li>
        </onHitEffects>
      </li>
    </modExtensions>
  </WeaponTraitDef>

</Defs>
