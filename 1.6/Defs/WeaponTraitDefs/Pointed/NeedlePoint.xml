<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- UMW_Pointed. Point shape — a fine needle that concentrates a thrust into a flat passive buff to
       melee damage AND armor penetration (both ride MeleeWeapon_DamageMultiplier — there is no separate
       melee AP stat), traded against a hit-chance penalty (a delicate point is less forgiving to
       land). DECISION: unlike UMW_HeadWeighted (whose incidental AP we neutralize), we deliberately KEEP
       the coupling here — a finer point genuinely drives deeper, so the AP riding along is the point of
       the trait. A pure-stat tradeoff, distinct from ArmorSpike's pure Stab-AP floor; shared "Point" tag
       keeps the two shape traits mutually exclusive. The hit-chance malus is delivered via the equipped
       UMW_NeedlePointGrip hediff, NOT equippedStatOffsets — that field is bladelink-only and is silently
       inert on our CompUniqueWeapon. That hediff's header carries the malus sizing: MeleeHitChance takes
       raw pre-curve units, so the cost is deliberately steeper for a low-skill wielder than an expert. -->
  <WeaponTraitDef>
    <defName>UMW_NeedlePoint</defName>
    <label>needle point</label>
    <description>Tapered to a fine needle, the point concentrates the full force of a thrust onto a single spot, driving deeper and punching through armor. The slender point is harder to land cleanly.</description>
    <commonality>1</commonality>
    <weaponCategory>UMW_Pointed</weaponCategory>
    <exclusionTags>
      <li>Point</li>
    </exclusionTags>
    <statOffsets>
      <MarketValue>50</MarketValue> <!-- cf. HighPowerRounds +60 (+30% dmg/+15% AP, x0.9 acc); we net less at typical skill -->
    </statOffsets>
    <statFactors>
      <MeleeWeapon_DamageMultiplier>1.2</MeleeWeapon_DamageMultiplier>
    </statFactors>
    <equippedHediffs>
      <li>UMW_NeedlePointGrip</li>
    </equippedHediffs>
    <traitAdjectives>
      <li>needle</li>
      <li>needling</li>
      <li>hypodermic</li>
    </traitAdjectives>
  </WeaponTraitDef>

</Defs>
