<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- UMW_Pointed. Point shape — a reinforced spike that punches through heavy armor. Realised
       via MeleeToolModExtension flooring the Stab tool's armor penetration to 0.6 (no extra hit, no damage
       change — the point itself just punches through). Sizing: vanilla ships exactly two explicit melee
       tool APs — the spear point at 0.50 (the dedicated anti-armor weapon) and the monosword at 0.90 (the
       ultratech pinnacle, mirrored by UMW_Monomolecular's 0.9 floor); everything else defaults to
       0.015*power (0.20-0.35). 0.6 sits just above the spear and leaves clear air below mono grade; the
       original 0.8 was nearly mono-grade on a commonality-1, +40 MV trait (2026-07 balance pass). On the
       spear itself the floor only rescues poor quality/soft stuff (its point scales past 0.6 on its own at
       high quality); on knife/gladius/longsword (base 0.20-0.35) it is the real upgrade. Distinct from
       NeedlePoint, which is a coupled damage+AP buff with a hit-chance cost; the shared "Point" tag keeps
       the two shapes mutually exclusive. -->
  <WeaponTraitDef>
    <defName>UMW_ArmorSpike</defName>
    <label>armor spike</label>
    <description>The point is reinforced into a heavy armor-piercing spike that punches through plate and carapace.</description>
    <commonality>1</commonality>
    <weaponCategory>UMW_Pointed</weaponCategory>
    <exclusionTags>
      <li>Point</li>
    </exclusionTags>
    <statOffsets>
      <MarketValue>40</MarketValue> <!-- cf. PiercingRounds -->
    </statOffsets>
    <traitAdjectives>
      <li>lancing</li>
      <li>armorbane</li>
      <li>punching</li>
    </traitAdjectives>
    <modExtensions>
      <li Class="UniqueMeleeWeapons.MeleeToolModExtension">
        <mods>
          <li>
            <capacities>
              <li>Stab</li>
            </capacities>
            <armorPenetrationFloor>0.6</armorPenetrationFloor>
          </li>
        </mods>
      </li>
    </modExtensions>
  </WeaponTraitDef>

</Defs>
