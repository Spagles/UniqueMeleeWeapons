<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Longsword (flagship). Core, Medieval. Cut+Stab, slow 2.6s swing -> all five melee categories
       (Melee, Bladed, Pointed, Heavy, Guarded — a longsword can plausibly mount a hand-guard, see
       WeaponCategoryDefs/Guarded.xml). -->
  <ThingDef ParentName="MeleeWeapon_LongSword">
    <defName>UMW_LongSword_Unique</defName>
    <label>unique longsword</label>
    <description>A longsword bearing the marks of a master's hand. No two are forged alike.</description>
    <thingClass>UniqueMeleeWeapons.UniqueMeleeWeapon</thingClass>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/UniqueWeapons/LongSword</texPath>
      <graphicClass>UniqueMeleeWeapons.Graphic_RandomComplex</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <generateAllowChance>0</generateAllowChance>
    <possessionCount>0</possessionCount>
    <tradeability>Sellable</tradeability>
    <thingSetMakerTags Inherit="False">
      <li>RewardStandardLowFreq</li>
      <li>UniqueWeapon</li>
      <li>UMW_UniqueMelee</li>
    </thingSetMakerTags>
    <recipeMaker Inherit="False" IsNull="True" />
    <thingCategories Inherit="False">
      <li>WeaponsUnique</li>
    </thingCategories>
    <descriptionHyperlinks>
      <ThingDef>MeleeWeapon_LongSword</ThingDef>
    </descriptionHyperlinks>
    <!-- Can't inherit comps: CompEquippableAbilityReloadable must replace CompEquippable
         (one CompEquippable-derived comp allowed). If BaseWeapon/BaseMeleeWeapon_*_Quality
         comps change in a vanilla update, replicate here. -->
    <comps Inherit="False">
      <li Class="CompProperties_EquippableAbilityReloadable" /> <!-- props populated by traits -->
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtWeaponMelee</nameMaker>
        <descriptionMaker>ArtDescription_WeaponMelee</descriptionMaker>
        <minQualityForArtistic>Excellent</minQualityForArtistic>
      </li>
      <li Class="CompProperties_UniqueWeapon">
        <weaponCategories>
          <li>UMW_Melee</li>
          <li>UMW_Bladed</li>
          <li>UMW_Pointed</li>
          <li>UMW_Heavy</li>
          <li>UMW_Guarded</li>
        </weaponCategories>
        <namerLabels>
          <li>longsword</li>
          <li>blade</li>
          <li>sword</li>
          <li>edge</li>
        </namerLabels>
      </li>
    </comps>
  </ThingDef>

</Defs>
