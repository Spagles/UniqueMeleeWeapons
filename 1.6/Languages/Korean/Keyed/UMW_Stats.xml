<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- Info card: per-trait effect lines under vanilla's "Weapon traits" entry, one " - ..." line
       each. Keep them short — the entry lists up to three traits at once. -->
  <!-- Per-tool damage / armor penetration. {0} is a tool capacity ("cut", "cut and stab") or the
       UMW_TraitStat_AllTools word when the trait modifies every tool. -->
  <!-- EN: melee -->
  <UMW_TraitStat_AllTools>근접</UMW_TraitStat_AllTools>

  <!-- EN: {0} damage -->
  <UMW_TraitStat_ToolDamage>{0} 피해량</UMW_TraitStat_ToolDamage>

  <!-- EN: {0} armor penetration -->
  <UMW_TraitStat_ToolArmorPenetration>{0} 방어 관통력</UMW_TraitStat_ToolArmorPenetration>

  <!-- EN: min. {0} -->
  <UMW_TraitStat_Minimum>최소 {0}</UMW_TraitStat_Minimum>

  <!-- Rerouted base hit. {0} is the injury hediff's label; the bleed clause is appended in
       parentheses when the new wound bleeds at a different rate than the one it replaces. -->
  <!-- EN: Wound type: {0} -->
  <UMW_TraitStat_WoundType>상처 종류: {0}</UMW_TraitStat_WoundType>

  <!-- EN: bleed rate {0} -->
  <UMW_TraitStat_BleedRate>출혈 {0}</UMW_TraitStat_BleedRate>

  <!-- EN: Stabs strike internal organs {0} of the time -->
  <UMW_TraitStat_ForcedInternal>찌르기가 {0}의 확률로 내부 장기를 타격</UMW_TraitStat_ForcedInternal>

  <!-- On-hit effects. {0} (or {1}) is one of the effect clauses below; the chance form is used
       whenever the effect can fail to proc. -->
  <!-- EN: On hit: {0} -->
  <UMW_TraitStat_OnHit>명중 시: {0}</UMW_TraitStat_OnHit>

  <!-- EN: On hit ({0}): {1} -->
  <UMW_TraitStat_OnHitChance>명중 시({0}): {1}</UMW_TraitStat_OnHitChance>

  <!-- EN: {0} {1} damage -->
  <UMW_TraitStat_ExtraDamage>{1} 피해 {0}</UMW_TraitStat_ExtraDamage>

  <!-- EN: {0} {1} damage, {2} armor penetration -->
  <UMW_TraitStat_ExtraDamageAP>{1} 피해 {0}, 방어 관통력 {2}</UMW_TraitStat_ExtraDamageAP>

  <!-- EN: {0} {1} damage, not reduced by armor -->
  <UMW_TraitStat_ExtraDamageIgnoreArmor>{1} 피해 {0}, 방어도로 감소되지 않음</UMW_TraitStat_ExtraDamageIgnoreArmor>

  <!-- EN: stun for {0} -->
  <UMW_TraitStat_Stun>{0}간 기절</UMW_TraitStat_Stun>

  <!-- EN: stagger for {0} ({1} move speed) -->
  <UMW_TraitStat_Stagger>{0}간 비틀거림(이동속도 {1})</UMW_TraitStat_Stagger>

  <!-- EN: {0} (flesh only) -->
  <UMW_TraitStat_FleshOnly>{0}(생체 대상만)</UMW_TraitStat_FleshOnly>

  <!-- EN: {0} (humanlikes only) -->
  <UMW_TraitStat_HumanlikeOnly>{0}(인간만)</UMW_TraitStat_HumanlikeOnly>

  <!-- Wielder-side stat effect. {0} is a stat line or, for a hediff with no stat modifiers, the
       hediff's own label. -->
  <!-- EN: {0} (wielder) -->
  <UMW_TraitStat_Wielder>{0}(사용자)</UMW_TraitStat_Wielder>

  <!-- Defender-side parry. {0} is the parry chance. -->
  <!-- EN: {0} chance to parry melee attacks -->
  <UMW_TraitStat_Parry>{0}의 확률로 근접 공격 받아넘김</UMW_TraitStat_Parry>

  <!-- Ability granted by the trait. {0} is the AbilityDef's label. -->
  <!-- EN: Grants ability: {0} -->
  <UMW_TraitStat_GrantsAbility>능력 부여: {0}</UMW_TraitStat_GrantsAbility>

  <!-- Forced art inscription: the weapon always carries an art title and description, regardless
       of quality. -->
  <!-- EN: Always bears an art inscription -->
  <UMW_TraitStat_ForcedArt>항상 예술 명문이 새겨져 있음</UMW_TraitStat_ForcedArt>

</LanguageData>
