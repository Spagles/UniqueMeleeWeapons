<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- Info card: the per-trait effect lines added to vanilla's "Weapon traits" entry. Each renders as
       one " - ..." line under its trait, matching the format vanilla uses for a trait's own
       statOffsets/statFactors. Keep them short — the entry lists up to three traits at once. -->

  <!-- Per-tool damage / armor penetration. {0} is a tool capacity ("coupant", "coupant et perçant",
       from Core's ToolCapacityDef labels) or the UMW_TraitStat_AllTools word when the trait modifies
       every tool. A tool capacity is an adjective in French and cannot simply precede "dégâts", so
       these two carry it as a parenthetical instead. -->
  <!-- EN: melee -->
  <UMW_TraitStat_AllTools>mêlée</UMW_TraitStat_AllTools>

  <!-- EN: {0} damage -->
  <UMW_TraitStat_ToolDamage>dégâts ({0})</UMW_TraitStat_ToolDamage>

  <!-- EN: {0} armor penetration -->
  <UMW_TraitStat_ToolArmorPenetration>pénétration d'armure ({0})</UMW_TraitStat_ToolArmorPenetration>

  <!-- EN: min. {0} -->
  <UMW_TraitStat_Minimum>min. {0}</UMW_TraitStat_Minimum>

  <!-- Rerouted base hit. {0} is the injury hediff's label; the bleed clause is appended in
       parentheses when the new wound bleeds at a different rate than the one it replaces. The
       forced-internal line states the rerouted damage's chance of hitting an internal organ. -->
  <!-- EN: Wound type: {0} -->
  <UMW_TraitStat_WoundType>Type de blessure : {0}</UMW_TraitStat_WoundType>

  <!-- EN: bleed rate {0} -->
  <UMW_TraitStat_BleedRate>saignement {0}</UMW_TraitStat_BleedRate>

  <!-- EN: Stabs strike internal organs {0} of the time -->
  <UMW_TraitStat_ForcedInternal>Les coups d'estoc touchent les organes internes dans {0} des cas</UMW_TraitStat_ForcedInternal>

  <!-- On-hit effects. {0} (or {1}) is one of the effect clauses below; the chance form is used
       whenever the effect can fail to proc. -->
  <!-- EN: On hit: {0} -->
  <UMW_TraitStat_OnHit>À l'impact : {0}</UMW_TraitStat_OnHit>

  <!-- EN: On hit ({0}): {1} -->
  <UMW_TraitStat_OnHitChance>À l'impact ({0}) : {1}</UMW_TraitStat_OnHitChance>

  <!-- {1} is a DamageDef label; French reaches it through "de", which the language worker elides to
       "d'" by itself before a vowel ("dégâts d'immolation", "dégâts d'IEM"). -->
  <!-- EN: {0} {1} damage -->
  <UMW_TraitStat_ExtraDamage>{0} dégâts de {1}</UMW_TraitStat_ExtraDamage>

  <!-- EN: {0} {1} damage, {2} armor penetration -->
  <UMW_TraitStat_ExtraDamageAP>{0} dégâts de {1}, {2} de pénétration d'armure</UMW_TraitStat_ExtraDamageAP>

  <!-- EN: {0} {1} damage, not reduced by armor -->
  <UMW_TraitStat_ExtraDamageIgnoreArmor>{0} dégâts de {1}, non réduits par l'armure</UMW_TraitStat_ExtraDamageIgnoreArmor>

  <!-- EN: stun for {0} -->
  <UMW_TraitStat_Stun>étourdissement pendant {0}</UMW_TraitStat_Stun>

  <!-- EN: stagger for {0} ({1} move speed) -->
  <UMW_TraitStat_Stagger>titubation pendant {0} ({1} de vitesse de déplacement)</UMW_TraitStat_Stagger>

  <!-- EN: {0} (flesh only) -->
  <UMW_TraitStat_FleshOnly>{0} (chair uniquement)</UMW_TraitStat_FleshOnly>

  <!-- EN: {0} (humanlikes only) -->
  <UMW_TraitStat_HumanlikeOnly>{0} (humanoïdes uniquement)</UMW_TraitStat_HumanlikeOnly>

  <!-- Wielder-side stat effect. {0} is a stat line or, for a hediff with no stat modifiers, the
       hediff's own label. The stat line is rendered unfinalized, so a stat with a postProcessCurve
       shows its raw offset rather than a percentage. -->
  <!-- EN: {0} (wielder) -->
  <UMW_TraitStat_Wielder>{0} (utilisateur)</UMW_TraitStat_Wielder>

  <!-- Defender-side parry. {0} is the parry chance. -->
  <!-- EN: {0} chance to parry melee attacks -->
  <UMW_TraitStat_Parry>{0} de chances de parer les attaques de mêlée</UMW_TraitStat_Parry>

  <!-- Ability granted by the trait. {0} is the AbilityDef's label. -->
  <!-- EN: Grants ability: {0} -->
  <UMW_TraitStat_GrantsAbility>Confère la capacité : {0}</UMW_TraitStat_GrantsAbility>

  <!-- Forced art inscription: the weapon always carries an art title and description, regardless of
       quality. -->
  <!-- EN: Always bears an art inscription -->
  <UMW_TraitStat_ForcedArt>Porte toujours une inscription artistique</UMW_TraitStat_ForcedArt>

</LanguageData>
