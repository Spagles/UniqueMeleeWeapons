<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Situational moodlet for wielding a UMW_Storied unique weapon: the passive half of the Storied
       trait (the active half is the UMW_RallyingCry ability, granted via abilityProps — see
       WeaponTraitDefs/Melee/Storied.xml). Unlike UMW_BloodStainedWeapon this is a plain single-stage
       thought with NO stage routing and NO nullification list: a weapon with a
       name and a remembered history is simply a source of quiet pride, not a balanced-both-ways
       effect, so there's nothing to route or exempt. Worker ThoughtWorker_StoriedWeapon reports the
       situation (primary weapon carries the trait) via the shared
       UniqueWeaponTraitUtility.PrimaryWeaponHasTrait scan factored out of
       ThoughtWorker_BloodStainedWeapon. -->
  <ThoughtDef>
    <defName>UMW_StoriedWeapon</defName>
    <workerClass>UniqueMeleeWeapons.ThoughtWorker_StoriedWeapon</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>storied weapon</label>
        <description>I'm carrying a weapon with a name and a history. The deeds of those who bore it before me are remembered, and one day mine will be too.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
